{
  "components": {
    "schemas": {
      "CreateOrderRequest": {
        "additionalProperties": false,
        "properties": {
          "currency": {
            "const": "RUB",
            "title": "Currency",
            "type": "string"
          },
          "customer_id": {
            "format": "uuid",
            "title": "Customer Id",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItemIn"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "customer_id",
          "currency",
          "items"
        ],
        "title": "CreateOrderRequest",
        "type": "object"
      },
      "OrderItemIn": {
        "additionalProperties": false,
        "properties": {
          "quantity": {
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Quantity",
            "type": "integer"
          },
          "sku": {
            "pattern": "^[A-Z0-9][A-Z0-9-]{0,63}$",
            "title": "Sku",
            "type": "string"
          },
          "unit_price_kopecks": {
            "maximum": 1000000000000.0,
            "minimum": 1.0,
            "title": "Unit Price Kopecks",
            "type": "integer"
          }
        },
        "required": [
          "sku",
          "quantity",
          "unit_price_kopecks"
        ],
        "title": "OrderItemIn",
        "type": "object"
      },
      "OrderItemOut": {
        "properties": {
          "quantity": {
            "title": "Quantity",
            "type": "integer"
          },
          "sku": {
            "title": "Sku",
            "type": "string"
          },
          "unit_price_kopecks": {
            "title": "Unit Price Kopecks",
            "type": "integer"
          }
        },
        "required": [
          "sku",
          "quantity",
          "unit_price_kopecks"
        ],
        "title": "OrderItemOut",
        "type": "object"
      },
      "OrderResponse": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "const": "RUB",
            "title": "Currency",
            "type": "string"
          },
          "customer_id": {
            "format": "uuid",
            "title": "Customer Id",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItemOut"
            },
            "title": "Items",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "total_kopecks": {
            "title": "Total Kopecks",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "customer_id",
          "status",
          "currency",
          "items",
          "total_kopecks",
          "created_at"
        ],
        "title": "OrderResponse",
        "type": "object"
      },
      "OrderStatus": {
        "enum": [
          "created"
        ],
        "title": "OrderStatus",
        "type": "string"
      },
      "PaginatedOrderResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "PaginatedOrderResponse",
        "type": "object"
      },
      "ProblemDetails": {
        "description": "Body of every API error, RFC 9457, media type application/problem+json.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Explanation of this occurrence, when there is something to add",
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationErrorItem"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "validation-error only: fields that failed validation. Submitted values are never echoed",
            "title": "Errors"
          },
          "instance": {
            "description": "Request path where the error occurred",
            "title": "Instance",
            "type": "string"
          },
          "status": {
            "description": "The HTTP status code of the response",
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "description": "Short summary of the error type, the same for every occurrence",
            "title": "Title",
            "type": "string"
          },
          "type": {
            "description": "Error type URI: a stable identifier, branch on it rather than on the text",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "instance"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "ValidationErrorItem": {
        "properties": {
          "loc": {
            "description": "Path to the field, e.g. ['body', 'customer_id']",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "description": "What is wrong with the value",
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "description": "Machine-readable validation error code",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationErrorItem",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Orders API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/orders": {
      "get": {
        "description": "Заказы клиента, новые сверху.\n``customer_id`` обязателен, без него эндпоинт позволял бы выгрузить всю таблицу.",
        "operationId": "get_orders_v1_orders_get",
        "parameters": [
          {
            "description": "Обязательный фильтр: заказы только одного клиента.",
            "in": "query",
            "name": "customer_id",
            "required": true,
            "schema": {
              "description": "Обязательный фильтр: заказы только одного клиента.",
              "format": "uuid",
              "title": "Customer Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 100,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Limit"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 512,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedOrderResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "malformed": {
                    "value": {
                      "detail": "Malformed cursor",
                      "instance": "/v1/orders",
                      "status": 400,
                      "title": "The provided cursor is invalid",
                      "type": "https://errors.orders.example/invalid-cursor"
                    }
                  },
                  "other-filters": {
                    "value": {
                      "detail": "Cursor was issued for different filters",
                      "instance": "/v1/orders",
                      "status": 400,
                      "title": "The provided cursor is invalid",
                      "type": "https://errors.orders.example/invalid-cursor"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The cursor is malformed, has an unknown version or was issued for another customer_id"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "validation-error": {
                    "value": {
                      "errors": [
                        {
                          "loc": [
                            "body",
                            "customer_id"
                          ],
                          "msg": "Input should be a valid UUID",
                          "type": "uuid_parsing"
                        }
                      ],
                      "instance": "/v1/orders",
                      "status": 422,
                      "title": "Request validation failed",
                      "type": "https://errors.orders.example/validation-error"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Request validation failed"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "internal-error": {
                    "value": {
                      "instance": "/v1/orders",
                      "status": 500,
                      "title": "Internal server error",
                      "type": "https://errors.orders.example/internal-error"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected server error. Details are only in the logs"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "db-unavailable": {
                    "value": {
                      "detail": "Could not get a database connection",
                      "instance": "/v1/orders",
                      "status": 503,
                      "title": "Database is temporarily unavailable",
                      "type": "https://errors.orders.example/db-unavailable"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Database is temporarily unavailable, retry after Retry-After seconds",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying the request",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Get Orders",
        "tags": [
          "Orders"
        ]
      },
      "post": {
        "operationId": "create_order_v1_orders_post",
        "parameters": [
          {
            "description": "Required. Unique key of the operation, ^[A-Za-z0-9_-]{8,64}$. Missing or malformed key → 400 idempotency-key-required. The same key with the same body replays the stored response.",
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Required. Unique key of the operation, ^[A-Za-z0-9_-]{8,64}$. Missing or malformed key → 400 idempotency-key-required. The same key with the same body replays the stored response.",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            },
            "description": "Order created, or the stored response replayed for a repeated Idempotency-Key",
            "headers": {
              "Idempotent-Replayed": {
                "description": "`true` when this is the stored response of an earlier request with the same key",
                "schema": {
                  "enum": [
                    "true"
                  ],
                  "type": "string"
                }
              },
              "Location": {
                "description": "Path of the created order",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "bad-format": {
                    "value": {
                      "detail": "Incorrect Idempotency-Key header. Correct template: ^[A-Za-z0-9_-]{8,64}$",
                      "instance": "/v1/orders",
                      "status": 400,
                      "title": "Idempotency-Key is incorrect or not given",
                      "type": "https://errors.orders.example/idempotency-key-required"
                    }
                  },
                  "missing": {
                    "value": {
                      "detail": "Idempotency-Key header is required",
                      "instance": "/v1/orders",
                      "status": 400,
                      "title": "Idempotency-Key is incorrect or not given",
                      "type": "https://errors.orders.example/idempotency-key-required"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Idempotency-Key header is missing or does not match ^[A-Za-z0-9_-]{8,64}$"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "idempotency-key-in-progress": {
                    "value": {
                      "detail": "The original request with this Idempotency-Key has not finished yet, retry later",
                      "instance": "/v1/orders",
                      "status": 409,
                      "title": "A request with this Idempotency-Key is still in progress",
                      "type": "https://errors.orders.example/idempotency-key-in-progress"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The original request with this Idempotency-Key is still running, retry after Retry-After seconds",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying the request",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "413": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "content-too-large": {
                    "value": {
                      "detail": "Request body must not exceed 65536 bytes",
                      "instance": "/v1/orders",
                      "status": 413,
                      "title": "Content Too Large",
                      "type": "https://errors.orders.example/content-too-large"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Request body exceeds max_request_body_bytes"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "idempotency-key-reuse": {
                    "value": {
                      "detail": "This Idempotency-Key was used with a different request body",
                      "instance": "/v1/orders",
                      "status": 422,
                      "title": "Idempotency-Key was already used with a different request",
                      "type": "https://errors.orders.example/idempotency-key-reuse"
                    }
                  },
                  "validation-error": {
                    "value": {
                      "errors": [
                        {
                          "loc": [
                            "body",
                            "customer_id"
                          ],
                          "msg": "Input should be a valid UUID",
                          "type": "uuid_parsing"
                        }
                      ],
                      "instance": "/v1/orders",
                      "status": 422,
                      "title": "Request validation failed",
                      "type": "https://errors.orders.example/validation-error"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Request validation failed, or the Idempotency-Key was already used with a different body"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "internal-error": {
                    "value": {
                      "instance": "/v1/orders",
                      "status": 500,
                      "title": "Internal server error",
                      "type": "https://errors.orders.example/internal-error"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected server error. Details are only in the logs"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "db-unavailable": {
                    "value": {
                      "detail": "Could not get a database connection",
                      "instance": "/v1/orders",
                      "status": 503,
                      "title": "Database is temporarily unavailable",
                      "type": "https://errors.orders.example/db-unavailable"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Database is temporarily unavailable, retry after Retry-After seconds",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying the request",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Create Order",
        "tags": [
          "Orders"
        ]
      }
    },
    "/v1/orders/{order_id}": {
      "get": {
        "operationId": "get_order_v1_orders__order_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Order Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "not-found": {
                    "value": {
                      "detail": "Order 3fa85f64-5717-4562-b3fc-2c963f66afa6 not found",
                      "instance": "/v1/orders/3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "status": 404,
                      "title": "Resource not found",
                      "type": "https://errors.orders.example/not-found"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Order not found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "validation-error": {
                    "value": {
                      "errors": [
                        {
                          "loc": [
                            "body",
                            "customer_id"
                          ],
                          "msg": "Input should be a valid UUID",
                          "type": "uuid_parsing"
                        }
                      ],
                      "instance": "/v1/orders",
                      "status": 422,
                      "title": "Request validation failed",
                      "type": "https://errors.orders.example/validation-error"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Request validation failed"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "internal-error": {
                    "value": {
                      "instance": "/v1/orders",
                      "status": 500,
                      "title": "Internal server error",
                      "type": "https://errors.orders.example/internal-error"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected server error. Details are only in the logs"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "db-unavailable": {
                    "value": {
                      "detail": "Could not get a database connection",
                      "instance": "/v1/orders",
                      "status": 503,
                      "title": "Database is temporarily unavailable",
                      "type": "https://errors.orders.example/db-unavailable"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Database is temporarily unavailable, retry after Retry-After seconds",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying the request",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Get Order",
        "tags": [
          "Orders"
        ]
      }
    }
  }
}

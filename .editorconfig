root = true

# 1. Глобальные настройки для всех файлов проекта
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# 2. Настройки для Python (PEP 8 стандарты)
[*.py]
indent_style = space
indent_size = 4

# Настройки для Go (Официальный стандарт gofmt)
[*.go]
indent_style = tab
indent_size = 4
tab_width = 4

# Файлы конфигураций и разметки
[*.{yaml,yml,json}]
indent_style = space
indent_size = 2
